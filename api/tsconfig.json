{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist/api",
    "rootDir": "..",
    "baseUrl": "..",
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts"
  ]
}
